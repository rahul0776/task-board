# Multi-stage build for production
# Stage 1: Build the React application
FROM node:18-alpine AS builder

WORKDIR /app

# Accept build-time environment variables
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# Copy package files
COPY package*.json ./

# Install all dependencies (the build itself needs devDependencies:
# react-scripts, tailwindcss, postcss, autoprefixer)
RUN npm ci

# Copy source code
COPY . .

# Build the application (REACT_APP_* vars are baked in at this step)
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# The nginx image's entrypoint runs envsubst on /etc/nginx/templates/*.template,
# substituting ${BACKEND_URL} so the API/WebSocket proxy target is configurable
# at runtime (set BACKEND_URL to the backend's URL, e.g. https://taskboard-backend.onrender.com)
COPY nginx.prod.conf.template /etc/nginx/templates/default.conf.template

# Copy built files from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/health || exit 1
