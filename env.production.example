# TaskBoard Production Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
DB_NAME=taskboard
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS Configuration
# Set to your frontend domain in production (e.g., https://taskboard.yourdomain.com)
CORS_ORIGIN=https://rahultaskboard.onrender.com

# Backend URL the frontend nginx proxies /api and /api/v1/ws to
BACKEND_URL=http://backend:8080

# Port Configuration (optional, defaults shown)
BACKEND_PORT=8080
FRONTEND_PORT=80

# Optional: External Database Connection
# If using managed database service (AWS RDS, etc.)
# Uncomment and configure these instead of using the postgres service
# DB_HOST=your-database-host.region.rds.amazonaws.com
# DB_PORT=5432

# Optional: External Redis
# If using managed Redis service (AWS ElastiCache, etc.)
# REDIS_HOST=your-redis-host.cache.amazonaws.com
# REDIS_PORT=6379

